INTERNFLY_MODE=offline
INTERNFLY_DATABASE_PATH=/data/internfly.db
INTERNFLY_STEP_SECONDS=1.0
INTERNFLY_AUTO_START=true
INTERNFLY_RUNNER_URL=http://runner:8001
INTERNFLY_ALLOW_LOCAL_RUNNER=false
INTERNFLY_CORS_ORIGINS=http://localhost:5173
# Set locally after creating/rotating a neuPrint token. Never commit a value.
NEUPRINT_TOKEN=
